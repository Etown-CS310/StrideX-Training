# Copy this file to .env and fill in the values. Never commit .env.

# Secret used to sign login tokens (JWTs). Any long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Path to the Firebase service account key (Firebase console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT=serviceAccount.json

# Google OAuth client ID (Google Cloud console > APIs & Services > Credentials > OAuth client ID).
# Both variables hold the same value: the server verifies tokens with GOOGLE_CLIENT_ID and the
# browser reads VITE_GOOGLE_CLIENT_ID (Vite only exposes variables prefixed with VITE_).
# A client ID is not a secret, but leave the client secret out of this file.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# Port for the API server (the Vite dev server forwards /api requests here)
PORT=3001
