# Copy this file to .env and fill in the values. Never commit .env.

# Secret used to sign login tokens (JWTs). Any long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Path to the Firebase service account key (Firebase console > Project settings > Service accounts)
FIREBASE_SERVICE_ACCOUNT=serviceAccount.json

# Port for the API server (the Vite dev server forwards /api requests here)
PORT=3001
